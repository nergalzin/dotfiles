{
  "mode": "dark",
  "extends": "defaultDark",
  "stylesheets": ["matugen-dark.css"],
  "colors": {
    "background": "{{colors.surface.dark.hex}}",
    "background-alternate": "{{colors.surface_container_lowest.dark.hex}}",
    "surface": "{{colors.surface_container.dark.hex}}",
    "surface-foreground": "{{colors.on_surface.dark.hex}}",
    "foreground": "{{colors.on_surface.dark.hex}}",
    "foreground-muted": "{{colors.on_surface_variant.dark.hex}}",
    "primary": "{{colors.primary.dark.hex}}",
    "black": "{{colors.surface_container_lowest.dark.hex}}",
    "white": "{{colors.on_surface.dark.hex}}",
    "state-error": "{{colors.error.dark.hex}}",
    "state-info": "{{colors.secondary.dark.hex}}",
    "state-success": "{{colors.tertiary.dark.hex}}",
    "state-warning": "{{colors.primary_fixed_dim.dark.hex}}"
  },
  "app": {
    "overlay-header": "linear-gradient(rgba({{colors.surface.dark.red}}, {{colors.surface.dark.green}}, {{colors.surface.dark.blue}}, 0.25) 0%, rgba({{colors.surface.dark.red}}, {{colors.surface.dark.green}}, {{colors.surface.dark.blue}}, 0.9) 100%), var(--theme-background-noise)",
    "overlay-subheader": "linear-gradient(180deg, rgba({{colors.primary.dark.red}}, {{colors.primary.dark.green}}, {{colors.primary.dark.blue}}, 0.06) 0%, var(--theme-colors-background) 100%), var(--theme-background-noise)",
    "scrollbar-size": "10px",
    "scrollbar-handle-border-radius": "10px",
    "scrollbar-track-border-radius": "10px",
    "scrollbar-handle-background": "rgba({{colors.primary.dark.red}}, {{colors.primary.dark.green}}, {{colors.primary.dark.blue}}, 0.28)",
    "scrollbar-handle-hover-background": "rgba({{colors.primary.dark.red}}, {{colors.primary.dark.green}}, {{colors.primary.dark.blue}}, 0.5)",
    "scrollbar-handle-active-background": "rgba({{colors.primary.dark.red}}, {{colors.primary.dark.green}}, {{colors.primary.dark.blue}}, 0.7)",
    "scrollbar-track-background": "transparent",
    "scrollbar-track-hover-background": "rgba({{colors.surface_container.dark.red}}, {{colors.surface_container.dark.green}}, {{colors.surface_container.dark.blue}}, 0.5)",
    "scrollbar-track-active-background": "rgba({{colors.surface_container.dark.red}}, {{colors.surface_container.dark.green}}, {{colors.surface_container.dark.blue}}, 0.5)"
  },
  "mantineOverride": { "primaryShade": { "dark": 6 } }
}
